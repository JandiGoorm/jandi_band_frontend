# 로컬 프론트 전용 설정. 실제 값은 루트 .env에서 관리
VITE_API_DOMAIN=http://localhost:3000/api
VITE_FRONT_URL=http://localhost:3000
VITE_KAKAO_REDIRECT_URI=http://localhost:3000/callback

# 운영과 같은 카카오 앱의 키를 관리자에게 요청. CLIENT_ID는 백엔드 REST API 키와 같은 값.
VITE_KAKAO_CLIENT_ID=
VITE_KAKAO_JAVASCRIPT_KEY=
VITE_KAKAOMAP_APP_KEY=
